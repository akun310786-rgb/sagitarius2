  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Profil pengguna privat beserta peran RBAC."
    },
    "/login_aliases/{aliasId}": {
      "schema": { "$ref": "#/entities/LoginAlias" },
      "description": "Pemetaan alias login tunggal berdasarkan nomor WhatsApp atau username."
    },
    "/agents/{agentId}": {
      "schema": { "$ref": "#/entities/AgentDirectory" },
      "description": "Direktori publik agen resmi wilayah Priangan Timur."
    },
    "/packages/{packageId}": {
      "schema": { "$ref": "#/entities/Package" },
      "description": "Katalog paket tabungan dan barang satuan sembako/daging."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "Kontrak tabungan parcel milik member."
    },
    "/deposits/{depositId}": {
      "schema": { "$ref": "#/entities/Deposit" },
      "description": "Riwayat setoran tabungan harian/mingguan dan penarikan."
    },
    "/contact_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ContactMessage" },
      "description": "Kotak pesan konsultasi dari pengunjung dan member."
    },
    "/app_settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppPublicSettings" },
      "description": "Pengaturan resmi rekening bank, QRIS, dan pengumuman broadcast."
    },
    "/door_prize_draws/{drawId}": {
      "schema": { "$ref": "#/entities/DoorPrizeDraw" },
      "description": "Daftar pemenang undian kupon Door Prize member."
    },
    "/agent_settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/AgentSettlement" },
      "description": "Rekap setor tunai harian agen ke pusat dan pencairan komisi agen."
    },
    "/warehouse_inventory/{itemId}": {
      "schema": { "$ref": "#/entities/WarehouseInventoryItem" },
      "description": "Stok barang masuk gudang dan harga beli satuan (HPP) untuk analisis pengadaan."
    },
    "/product_substitutions/{subId}": {
      "schema": { "$ref": "#/entities/ProductSubstitution" },
      "description": "Catatan resmi penggantian item paket dengan barang setara harga."
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Log audit permanen perubahan sensitif Admin Pusat."
    }
  }
}
