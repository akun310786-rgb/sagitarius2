          "type": "string",
          "minLength": 5,
          "maxLength": 150
        },
        "alias_type": {
          "type": "string",
          "enum": ["wa", "username"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "auth_email", "alias_type", "createdAt", "updatedAt"]
    },
